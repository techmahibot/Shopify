# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/shopkart

# Port the API listens on
PORT=5001

# Any long random string, used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL(s) allowed to call this API (comma separated, no trailing slash)
CLIENT_URL=http://localhost:5173

# Razorpay TEST mode keys (Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Set to "production" when deployed (turns on Secure cookies)
# NODE_ENV=production
